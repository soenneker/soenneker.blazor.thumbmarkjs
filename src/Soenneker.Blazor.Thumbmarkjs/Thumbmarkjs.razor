@using Microsoft.JSInterop
@using Microsoft.Extensions.Logging
@using System.Text.Json
@using System.Threading
@using Soenneker.Blazor.Extensions.EventCallback
@using Soenneker.Blazor.Thumbmarkjs.Abstract
@using Soenneker.Blazor.Thumbmarkjs.Configuration
@using Soenneker.Extensions.CancellationTokens
@using Soenneker.Blazor.Utils.Ids

@inherits Soenneker.Lepton.Suite.LeptonCancellableIdentifiableContentElement
@implements IThumbmarkjs

<div id="@Id" @attributes="EffectiveAttributes"></div>

@code {
    [Inject]
    private IThumbmarkjsInterop ThumbmarkjsInterop { get; set; } = null!;

    [Inject]
    private ILogger<Thumbmarkjs> Logger { get; set; } = null!;

    [Parameter]
    public ThumbmarkjsOptions? Options { get; set; }

    [Parameter]
    public EventCallback<string> OnGenerated { get; set; }

    [Parameter]
    public EventCallback<JsonElement> OnDataGenerated { get; set; }

    [Parameter]
    public EventCallback OnReady { get; set; }

    public Thumbmarkjs()
    {
        Id = BlazorIdGenerator.New("thumbmarkjs");
    }

    private DotNetObjectReference<Thumbmarkjs>? _dotNetReference;
    private bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized)
            return;

        DotNetObjectReference<Thumbmarkjs> reference = DotNetObjectReference.Create(this);
        _dotNetReference = reference;

        ThumbmarkjsOptions options = Options ?? new ThumbmarkjsOptions();

        try
        {
            await ThumbmarkjsInterop.Initialize(Id!, reference, options.UseCdn, CancellationToken);
            await ThumbmarkjsInterop.SetOptions(Id!, options, CancellationToken);
            await ThumbmarkjsInterop.CreateObserver(Id!, CancellationToken);
        }
        catch
        {
            try
            {
                await ThumbmarkjsInterop.Dispose(Id!);
            }
            catch
            {
                // Preserve the initialization exception; browser cleanup is best effort on this path.
            }

            reference.Dispose();
            _dotNetReference = null;
            throw;
        }

        _initialized = true;
        await OnReady.InvokeIfHasDelegate();
    }

    [JSInvokable("OnGenerated")]
    public async Task OnGeneratedJs(string? thumbmark)
    {
        if (thumbmark is null)
            return;

        try
        {
            await OnGenerated.InvokeIfHasDelegate(thumbmark);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error invoking OnGenerated callback");
        }
    }

    [JSInvokable("OnDataGenerated")]
    public async Task OnDataGeneratedJs(JsonElement jsonElement)
    {
        try
        {
            await OnDataGenerated.InvokeIfHasDelegate(jsonElement);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error invoking OnDataGenerated callback");
        }
    }

    public async ValueTask SetOptions(object options, CancellationToken cancellationToken = default)
    {
        EnsureInitialized();
        ArgumentNullException.ThrowIfNull(options);

        CancellationToken linked = CancellationToken.Link(cancellationToken, out CancellationTokenSource? cts);

        using (cts)
        {
            await ThumbmarkjsInterop.SetOptions(Id!, options, linked);
        }
    }

    public async ValueTask<string?> Get(CancellationToken cancellationToken = default)
    {
        EnsureInitialized();

        CancellationToken linked = CancellationToken.Link(cancellationToken, out CancellationTokenSource? cts);

        using (cts)
        {
            return await ThumbmarkjsInterop.Get(Id!, linked);
        }
    }

    public async ValueTask<JsonElement?> GetData(CancellationToken cancellationToken = default)
    {
        EnsureInitialized();

        CancellationToken linked = CancellationToken.Link(cancellationToken, out CancellationTokenSource? cts);

        using (cts)
        {
            return await ThumbmarkjsInterop.GetData(Id!, linked);
        }
    }

    private void EnsureInitialized()
    {
        if (!_initialized)
            throw new InvalidOperationException("ThumbmarkJS is not ready. Wait for the OnReady callback before calling this method.");
    }

    public override async ValueTask DisposeAsync()
    {
        try
        {
            if (_initialized && Id is not null)
            {
                await ThumbmarkjsInterop.Dispose(Id);
            }
        }
        catch (JSDisconnectedException)
        {
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Error disposing Thumbmarkjs interop");
        }

        _dotNetReference?.Dispose();
        _dotNetReference = null;
        _initialized = false;

        await base.DisposeAsync();
    }
}
